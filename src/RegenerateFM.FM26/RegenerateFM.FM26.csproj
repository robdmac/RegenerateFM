<Project Sdk="Microsoft.NET.Sdk">
  <!-- The FM26 BepInEx plugin, BepInEx/plugins/RegenerateFM/RegenerateFM.dll.
       It compiles RegenerateFM.Core's files in, so it is one DLL. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>RegenerateFM</AssemblyName>
    <RootNamespace>RegenerateFM.FM26</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- BindingPaths: passing spans to FM26 by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Target Name="RequireGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Pass -p:GameDir=/path/to/Football Manager 26 when building the FM26 plugin." />
  </Target>
  <ItemGroup>
    <Compile Include="../RegenerateFM.Core/**/*.cs" Exclude="../RegenerateFM.Core/obj/**;../RegenerateFM.Core/bin/**" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GameDir)/BepInEx/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="SI.Core" HintPath="$(GameDir)/BepInEx/interop/SI.Core.dll" Private="false" />
    <Reference Include="SI.Bindable" HintPath="$(GameDir)/BepInEx/interop/SI.Bindable.dll" Private="false" />
    <Reference Include="SI.Input" HintPath="$(GameDir)/BepInEx/interop/SI.Input.dll" Private="false" />
    <Reference Include="FM.Match" HintPath="$(GameDir)/BepInEx/interop/FM.Match.dll" Private="false" />
    <Reference Include="SI.Anim" HintPath="$(GameDir)/BepInEx/interop/SI.Anim.dll" Private="false" />
    <Reference Include="SI.Match" HintPath="$(GameDir)/BepInEx/interop/SI.Match.dll" Private="false" />
    <Reference Include="SI.UI" HintPath="$(GameDir)/BepInEx/interop/SI.UI.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameDir)/BepInEx/interop/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameDir)/BepInEx/interop/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIElementsModule" HintPath="$(GameDir)/BepInEx/interop/UnityEngine.UIElementsModule.dll" Private="false" />
  </ItemGroup>
</Project>
