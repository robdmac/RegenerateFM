+using System;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace Il2CppInterop.Common;
+
+/// <summary>
+///     The loaded IL2CPP game assembly: its file name, load address and the size of memory to scan for code.
+///     On macOS, .NET's Process.Modules lists only the main executable (with a zero base address), so the
+///     game assembly is looked up through dyld there, and only its __TEXT segment is used for scanning.
+/// </summary>
+public sealed class GameAssemblyModule
+{
+    private static readonly string[] Names = { "GameAssembly.dll", "GameAssembly.dylib", "GameAssembly.so", "UserAssembly.dll" };
+
+    private GameAssemblyModule(string moduleName, IntPtr baseAddress, long moduleMemorySize)
+    {
+        ModuleName = moduleName;
+        BaseAddress = baseAddress;
+        ModuleMemorySize = moduleMemorySize;
+    }
+
+    public string ModuleName { get; }
+    public IntPtr BaseAddress { get; }
+    public long ModuleMemorySize { get; }
+
+    /// <summary>The game assembly, or null if it isn't loaded.</summary>
+    public static GameAssemblyModule TryFind()
+    {
+        return RuntimeInformation.IsOSPlatform(OSPlatform.OSX) ? FindWithDyld() : FindInProcessModules();
+    }
+
+    /// <summary>The game assembly; throws if it isn't loaded.</summary>
+    public static GameAssemblyModule Find()
+    {
+        return TryFind() ?? throw new InvalidOperationException(
+            "Couldn't find the IL2CPP game assembly (" + string.Join(", ", Names) + ") among the loaded modules.");
+    }
+
+    private static bool IsGameAssembly(string fileName)
+    {
+        foreach (var name in Names)
+            if (string.Equals(fileName, name, StringComparison.OrdinalIgnoreCase))
+                return true;
+        return false;
+    }
+
+    private static GameAssemblyModule FindInProcessModules()
+    {
+        foreach (ProcessModule module in Process.GetCurrentProcess().Modules)
+            if (IsGameAssembly(module.ModuleName))
+                return new GameAssemblyModule(module.ModuleName, module.BaseAddress, module.ModuleMemorySize);
+        return null;
+    }
+
+    private const string LibSystem = "/usr/lib/libSystem.B.dylib";
+    private const uint MachHeader64Magic = 0xfeedfacf;
+    private const int MachHeader64Size = 32;
+    private const uint LoadCommandSegment64 = 0x19;
+
+    [DllImport(LibSystem)]
+    private static extern uint _dyld_image_count();
+
+    [DllImport(LibSystem)]
+    private static extern IntPtr _dyld_get_image_name(uint index);
+
+    [DllImport(LibSystem)]
+    private static extern IntPtr _dyld_get_image_header(uint index);
+
+    private static GameAssemblyModule FindWithDyld()
+    {
+        var count = _dyld_image_count();
+        for (uint i = 0; i < count; i++)
+        {
+            var path = PtrToStringUtf8(_dyld_get_image_name(i));
+            if (path == null)
+                continue;
+            var fileName = path.Substring(path.LastIndexOf('/') + 1);
+            if (!IsGameAssembly(fileName))
+                continue;
+            var header = _dyld_get_image_header(i);
+            if (header == IntPtr.Zero || (uint)Marshal.ReadInt32(header) != MachHeader64Magic)
+                continue;
+            var textSize = TextSegmentSize(header);
+            if (textSize > 0)
+                return new GameAssemblyModule(fileName, header, textSize);
+        }
+        return null;
+    }
+
+    // The __TEXT segment starts at the Mach-O header and holds the code that signatures are searched for.
+    private static long TextSegmentSize(IntPtr header)
+    {
+        var commandCount = Marshal.ReadInt32(header, 16);
+        var command = header + MachHeader64Size;
+        for (var i = 0; i < commandCount; i++)
+        {
+            var kind = (uint)Marshal.ReadInt32(command);
+            var size = Marshal.ReadInt32(command, 4);
+            if (kind == LoadCommandSegment64 && PtrToStringUtf8(command + 8, 16) == "__TEXT")
+                return Marshal.ReadInt64(command, 32);
+            if (size <= 0)
+                break;
+            command += size;
+        }
+        return 0;
+    }
+
+    private static string PtrToStringUtf8(IntPtr pointer, int maxLength = 4096)
+    {
+        if (pointer == IntPtr.Zero)
+            return null;
+        var length = 0;
+        while (length < maxLength && Marshal.ReadByte(pointer, length) != 0)
+            length++;
+        var bytes = new byte[length];
+        Marshal.Copy(pointer, bytes, 0, length);
+        return Encoding.UTF8.GetString(bytes);
+    }
+}
