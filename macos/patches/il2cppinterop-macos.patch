+    /// <summary>
+    ///     The target of the tail call that ends a function's straight-line code (calls are allowed before it), or
+    ///     zero if the code returns or branches first. Unlike <see cref="JumpTargets" /> this doesn't run on into the
+    ///     next function when functions are padded with nops instead of int3, as clang does on macOS.
+    /// </summary>
+    public static IntPtr TailCallTarget(IntPtr codeStart)
+    {
+        return StraightLineEnd(codeStart, out _);
+    }
+
+    /// <summary>
+    ///     Follows tail calls through functions that are straight-line code with no calls (thunks, and wrappers that
+    ///     only compute an argument, even with branches inside, as FM27's GetTypeInfoFromHandle picks a 32- or 64-bit
+    ///     division before tail-calling GetTypeInfoFromTypeDefinitionIndex), and returns the first function that
+    ///     isn't one.
+    /// </summary>
+    public static IntPtr FollowTailCalls(IntPtr codeStart)
+    {
+        for (var i = 0; i < 16; i++)
+        {
+            var next = StraightLineEnd(codeStart, out var calls);
+            if (next == IntPtr.Zero || calls)
+                return codeStart;
+            codeStart = next;
+        }
+        return codeStart;
+    }
+
+    /// <summary>
+    ///     The target of the first call in a function whose second argument (rsi) was just set to the address of a
+    ///     stack slot, the way clang passes an out parameter, or zero if there is none before the function returns.
+    /// </summary>
+    public static IntPtr CallWithStackAddressArgument(IntPtr codeStart)
+    {
+        var decoder = XrefScanner.DecoderForAddress(codeStart);
+        var sinceLea = -1;
+        for (var i = 0; i < 512; i++)
+        {
+            decoder.Decode(out var instruction);
+            if (decoder.LastError == DecoderError.NoMoreBytes || instruction.FlowControl == FlowControl.Return)
+                break;
+            if (instruction.Mnemonic == Mnemonic.Lea && instruction.Op0Register == Register.RSI &&
+                instruction.MemoryBase is Register.RBP or Register.RSP)
+            {
+                sinceLea = 0;
+                continue;
+            }
+            if (instruction.FlowControl == FlowControl.Call && sinceLea is >= 0 and <= 2 &&
+                instruction.Op0Kind is OpKind.NearBranch32 or OpKind.NearBranch64)
+                return (IntPtr)ExtractTargetAddress(in instruction);
+            if (sinceLea >= 0)
+                sinceLea++;
+        }
+        return IntPtr.Zero;
+    }
+
+    private static IntPtr StraightLineEnd(IntPtr codeStart, out bool calls)
+    {
+        calls = false;
+        var decoder = XrefScanner.DecoderForAddress(codeStart);
+        for (var i = 0; i < 256; i++)
+        {
+            decoder.Decode(out var instruction);
+            if (decoder.LastError == DecoderError.NoMoreBytes)
+                break;
+            if (instruction.FlowControl == FlowControl.Call)
+            {
+                calls = true;
+                continue;
+            }
+            if (instruction.FlowControl == FlowControl.UnconditionalBranch && !instruction.IsJmpShort &&
+                instruction.Op0Kind is OpKind.NearBranch32 or OpKind.NearBranch64)
+                return (IntPtr)ExtractTargetAddress(in instruction);
+            // A branch inside the function: read on, to the tail call its paths end in.
+            if (instruction.FlowControl == FlowControl.ConditionalBranch)
+                continue;
+            if (instruction.FlowControl != FlowControl.Next)
+                break;
+        }
+        return IntPtr.Zero;
+    }
+
