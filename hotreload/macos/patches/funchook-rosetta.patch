 #define SAFE_JUMP_DISTANCE(X, Y)  ((size_t)(X) - (size_t)(Y)) < (INT32_MAX - page_size)
 
+#if defined(FUNCHOOK_RESERVE_PAGES)
+/* BepInEx makes one funchook per hook, and each takes a trampoline page within
+ * 2GB of its target. Under Rosetta 2 the address space near the game's code is
+ * used up while the game starts, so later hooks found no page. The first page
+ * allocation reserves FUNCHOOK_RESERVE_PAGES pages near its target, and later
+ * pages come from that block while it is in range. */
+static pthread_mutex_t reserve_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t *reserve_next;
+static uint8_t *reserve_end;
+
+static int reserve_in_range(const uint8_t *func, const uint8_t *page)
+{
+    return SAFE_JUMP_DISTANCE(func, page) || SAFE_JUMP_DISTANCE(page, func);
+}
+
+static void reserve_pages(funchook_t *funchook, uint8_t *func)
+{
+    size_t size = page_size * FUNCHOOK_RESERVE_PAGES;
+    void *addrs[2];
+    int i;
+
+    if (get_free_address(funchook, func, addrs, size) != 0) {
+        return;
+    }
+    for (i = 1; i >= 0; i--) {
+        uint8_t *block;
+
+        if (addrs[i] == NULL) {
+            continue;
+        }
+        block = mmap(addrs[i], size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (block == MAP_FAILED) {
+            continue;
+        }
+        if (reserve_in_range(func, block) && reserve_in_range(func, block + size - page_size)) {
+            funchook_log(funchook, "  reserve %d pages at %p\n", FUNCHOOK_RESERVE_PAGES, block);
+            reserve_next = block;
+            reserve_end = block + size;
+            return;
+        }
+        munmap(block, size);
+    }
+}
+#endif
+
 #endif /* defined(CPU_64BIT) */
 
