+/* Patches the start of a function. A patch that fits in one aligned 8-byte
+ * word is written with a single atomic store, so a thread running the function
+ * (or Rosetta translating it) never sees a half-written jump. */
+static void write_code(void *dst, const void *src, size_t len)
+{
+#if defined(__x86_64__) && defined(FUNCHOOK_ATOMIC_PATCH)
+    uintptr_t addr = (uintptr_t)dst;
+    uintptr_t word = addr & ~(uintptr_t)7;
+    if (addr + len <= word + 8) {
+        uint64_t value = __atomic_load_n((uint64_t *)word, __ATOMIC_RELAXED);
+        memcpy((uint8_t *)&value + (addr - word), src, len);
+        __atomic_store_n((uint64_t *)word, value, __ATOMIC_SEQ_CST);
+        return;
+    }
+#endif
+    memcpy(dst, src, len);
+}
+
