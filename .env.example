# Copy this file to .env and add your own API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional rendering quality: low, medium, high, xhigh, max, or auto.
OPENAI_IMAGE_QUALITY=medium
# Optional, for testing only: a local stand-in for the image API, e.g.
# http://127.0.0.1:8899/v1 (plain http is accepted only on this computer).
OPENAI_BASE_URL=
# Optional: where the web form and `fmface.py import` save portraits, e.g. FM26's
# user-data graphics/fmface folder (not the Steam game folder). Blank stages them in
# ./output/fm26_faces. The FM26 plugin asks for its key in the game instead.
FM_GRAPHICS_DIR=
