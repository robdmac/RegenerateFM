# Copy this file to .env and add your own API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional rendering quality: low, medium, high, xhigh, max, or auto.
OPENAI_IMAGE_QUALITY=medium
# Required for the in-game Generate face button. Manual web/import may leave it blank
# to stage portraits in ./output/fm26_faces.
# Use the FM26 user-data graphics folder, not the Steam game folder.
FM_GRAPHICS_DIR=
